+    /// Searches vectors grouped by a scalar field, with per-group result limits.
+    pub fn group_by_query(&self, query: &GroupBySearchQuery) -> Result<Vec<GroupResult>> {
+        let mut results = ptr::null_mut();
+        let mut count = 0;
+        check_error(unsafe {
+            zvec_rust_sys::zvec_collection_group_by_query(
+                self.handle,
+                query.handle,
+                &mut results,
+                &mut count,
+            )
+        })?;
+        let guard = GroupResultsGuard(results, count);
+        if results.is_null() {
+            return Ok(Vec::new());
+        }
+        let mut groups = Vec::with_capacity(count);
+        for i in 0..count {
+            // The guard owns all native arrays and strings. Detach each document
+            // before wrapping it so native cleanup cannot destroy Rust-owned docs.
+            let group = unsafe { &mut *guard.0.add(i) };
+            let group_by_value = if group.group_by_value.is_null() {
+                String::new()
+            } else {
+                unsafe { CStr::from_ptr(group.group_by_value) }
+                    .to_string_lossy()
+                    .into_owned()
+            };
+            let mut docs = Vec::with_capacity(group.doc_count);
+            for j in 0..group.doc_count {
+                let doc = unsafe { ptr::replace(group.docs.add(j), ptr::null_mut()) };
+                if !doc.is_null() {
+                    docs.push(unsafe { Doc::from_raw(doc) });
+                }
+            }
+            groups.push(GroupResult {
+                group_by_value,
+                docs,
+            });
+        }
+        Ok(groups)
+    }

