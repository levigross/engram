+//! Regression coverage for the local v0.8.1 API additions to the pinned crates.
+use std::sync::Once;
+use crate::*;
+
+fn init() {
+    static INIT: Once = Once::new();
+    INIT.call_once(|| initialize(None).unwrap());
+}
