+/// Owned results of one group. Documents remain valid after the collection and
+/// query are dropped, and are freed normally when their Rust owners are dropped.
+pub struct GroupResult {
+    pub group_by_value: String,
+    pub docs: Vec<Doc>,
+}
+
+struct GroupResultsGuard(*mut zvec_rust_sys::zvec_group_result_t, usize);
+
+impl Drop for GroupResultsGuard {
+    fn drop(&mut self) {
+        unsafe { zvec_rust_sys::zvec_group_results_free(self.0, self.1) };
+    }
+}

