+    /// Adds a typed field through the C structure API. Data is copied before
+    /// returning, so the document does not borrow the supplied name or value.
+    pub fn add_field(&mut self, name: &str, value: FieldValue<'_>) -> Result<()> {
+        use std::mem::ManuallyDrop;
+        use zvec_rust_sys::{zvec_field_value_t as V, zvec_string_t as S};
+        let name = to_cstring(name)?;
+        let (data_type, value) = match value {
+            FieldValue::Bool(v) => (DataType::Bool, V { bool_value: v }),
+            FieldValue::Int32(v) => (DataType::Int32, V { int32_value: v }),
+            FieldValue::Int64(v) => (DataType::Int64, V { int64_value: v }),
+            FieldValue::Uint32(v) => (DataType::Uint32, V { uint32_value: v }),
+            FieldValue::Uint64(v) => (DataType::Uint64, V { uint64_value: v }),
+            FieldValue::Float(v) => (DataType::Float, V { float_value: v }),
+            FieldValue::Double(v) => (DataType::Double, V { double_value: v }),
+            FieldValue::String(v) => (
+                DataType::String,
+                V {
+                    string_value: ManuallyDrop::new(S {
+                        data: v.as_ptr() as *mut _,
+                        length: v.len(),
+                        capacity: v.len(),
+                    }),
+                },
+            ),
+            FieldValue::Binary(v) => (
+                DataType::Binary,
+                V {
+                    binary_value: ManuallyDrop::new(zvec_rust_sys::zvec_byte_array_t {
+                        data: v.as_ptr(),
+                        length: v.len(),
+                    }),
+                },
+            ),
+            FieldValue::VectorF32(v) => (
+                DataType::VectorFp32,
+                V {
+                    vector_value: ManuallyDrop::new(zvec_rust_sys::zvec_float_array_t {
+                        data: v.as_ptr(),
+                        length: v.len(),
+                    }),
+                },
+            ),
+        };
+        let field = zvec_rust_sys::zvec_doc_field_t {
+            name: S {
+                data: name.as_ptr() as *mut _,
+                length: name.as_bytes().len(),
+                capacity: name.as_bytes_with_nul().len(),
+            },
+            data_type: data_type as u32,
+            value,
+        };
+        check_error(unsafe { zvec_rust_sys::zvec_doc_add_field_by_struct(self.handle, &field) })
     }

